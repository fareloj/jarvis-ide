# Default mode: use the local Ollama process as a gateway to Ollama Cloud.
JARVIS_OLLAMA_HOST=http://127.0.0.1:11434
JARVIS_OLLAMA_MODEL=gpt-oss:120b-cloud

# For direct Ollama Cloud access, use:
# JARVIS_OLLAMA_HOST=https://ollama.com
# OLLAMA_API_KEY=replace-with-your-key

JARVIS_BACKEND_HOST=127.0.0.1

# Web search used by the agent (web_search tool). Without any key configured,
# JARVIS falls back to DuckDuckGo HTML scraping (no signup, but lower quality).
# For better results, get a free key and set one of these:
#   Tavily  (built for LLM consumption, 1000 free credits/month, no card):
#     https://app.tavily.com
#   Brave Search (own index, fast, has a free tier):
#     https://api.search.brave.com
# JARVIS picks the best available automatically (tavily > brave > duckduckgo),
# or force one explicitly with JARVIS_WEB_SEARCH_PROVIDER=tavily|brave|duckduckgo|bing
# JARVIS_TAVILY_API_KEY=replace-with-your-key
# JARVIS_BRAVE_SEARCH_API_KEY=replace-with-your-key

# Direct Ollama Cloud quota synchronization (from https://ollama.com/settings)
# OLLAMA_SESSION_COOKIE=replace-with-your-wos-session-cookie

# Cross-chat semantic memory. Embeddings come from the Hybrid RAG Engine's
# Ollama instance; without it the chat still works, it just stops recalling
# what was said in other conversations.
# JARVIS_EMBED_URL=http://127.0.0.1:11435
# JARVIS_EMBED_MODEL=qwen3-embedding:0.6b
# Set to 0 to disable it entirely (can also be toggled in Settings).
# JARVIS_CONVERSATION_MEMORY=1
# JARVIS_CONVERSATION_MEMORY_PATH=./data/conversation-memory
